<view><cu-custom vue-id="3e2494c0-1" bgColor="{{'bg-gradual-'+themeClass}}" isBack="{{isBack}}" bind:__l="__l" vue-slots="{{['content']}}"><view slot="content">任务中心</view></cu-custom><view class="how"><view class="margin-top-sm padding bg-white radius-xl flex"><view style="width:70%;"><view><view class="cu-tag radius sm bg-olive shadow margin-bottom-xs">签到</view><text class="text-black text-lg margin-left-sm">每日签到</text></view><view class="text-xs margin-top-sm">{{'每日签到赠送'+(setting.wxConfig.money_qiandao||0)+'枚金币'}}</view></view><view class="flex" style="width:30%;align-items:center;justify-content:center;"><button class="{{['cu-btn','','round','shadow','block',qd?'block':'bg-'+themeClass]}}" style="margin-left:auto;" disabled="{{qd}}" data-event-opts="{{[['tap',[['qiandao']]]]}}" bindtap="__e">{{qd?'已完成':'去完成'}}</button></view></view><block wx:if="{{invite.invite_switch==1}}"><view class="margin-top padding bg-white radius-xl flex"><view style="width:70%;"><view><view class="cu-tag radius sm bg-red shadow margin-bottom-xs">邀请</view><text class="text-black text-lg margin-left-sm">{{'邀请好友得'+(invite.invite_reward==0?'会员':'金币')+''}}</text></view><view class="text-xs margin-top-sm">{{'邀请好友使用小程序奖励 '+invite.invite_reward_msg+(invite.invite_reward==0?' 天无广告超级会员':' 枚金币')+''}}</view></view><view class="flex" style="width:30%;align-items:center;justify-content:center;"><button data-event-opts="{{[['tap',[['goPage',['/pages/task/invite']]]]]}}" class="{{['cu-btn','','round','shadow','bg-'+themeClass]}}" style="margin-left:auto;" bindtap="__e">去完成</button></view></view></block><block wx:if="{{is_vip==1}}"><view class="margin-top padding bg-white radius-xl flex"><view style="width:70%;"><view><view class="cu-tag radius sm bg-red shadow margin-bottom-xs">会员</view><text class="text-black text-lg margin-left-sm">不限解析次数会员</text></view><view class="text-xs margin-top-sm">{{'观看广告奖励'+(setting.wxConfig.vip_time||0)+"小时普通会员，每天可得"+setting.wxConfig.vip_cishu+'次奖励'}}</view></view><view class="flex" style="width:30%;align-items:center;justify-content:center;"><button data-event-opts="{{[['tap',[['showAd',['vip']]]]]}}" class="{{['cu-btn','','round','shadow','bg-'+themeClass]}}" style="margin-left:auto;" bindtap="__e">去完成</button></view></view></block><block wx:if="{{ad_id!='关闭'}}"><view class="margin-top padding bg-white radius-xl flex"><view style="width:70%;"><view><view class="cu-tag radius sm bg-orange shadow margin-bottom-xs">限时</view><text class="text-black text-lg margin-left-sm">看广告得金币</text></view><view class="text-xs margin-top-sm">{{'【'+(taskData.ad.this||0)+"/"+(taskData.ad.num||0)+"】观看广告奖励"+(setting.wxConfig.money_ad||0)+'枚金币'}}</view></view><view class="flex" style="width:30%;align-items:center;justify-content:center;"><button class="{{['cu-btn','','round','shadow','block',taskData.ad.this>=taskData.ad.num?'block':'bg-'+themeClass]}}" style="margin-left:auto;" disabled="{{taskData.ad.this>=taskData.ad.num}}" data-event-opts="{{[['tap',[['goTask',['ad']]]]]}}" bindtap="__e">{{(taskData.ad.this>=taskData.ad.num?'已完成':'去完成')+''}}</button></view></view></block><view class="margin-top padding bg-white radius-xl flex"><view style="width:70%;"><view><view class="cu-tag radius sm bg-blue shadow margin-bottom-xs">分享</view><text class="text-black text-lg margin-left-sm">分享好友得金币</text></view><view class="text-xs margin-top-sm">{{'【'+(taskData.share.this||0)+"/"+(taskData.share.num||0)+"】每次分享奖励"+(setting.wxConfig.money_share||0)+'枚金币'}}</view></view><view class="flex" style="width:30%;align-items:center;justify-content:center;"><button class="{{['cu-btn','','round','shadow','block',taskData.share.this>=taskData.share.num?'block':'bg-'+themeClass]}}" style="margin-left:auto;" open-type="share" disabled="{{taskData.share.this>=taskData.share.num}}" data-event-opts="{{[['tap',[['goTask',['share']]]]]}}" bindtap="__e">{{(taskData.share.this>=taskData.share.num?'已完成':'去完成')+''}}</button></view></view><block wx:if="{{!login}}"><view class="margin-top-sm padding bg-white radius-xl flex"><view style="width:70%;"><view><view class="cu-tag radius sm bg-olive shadow margin-bottom-xs">新人</view><text class="text-black text-lg margin-left-sm">新人免费福利</text></view><view class="text-xs margin-top-sm">{{'首次登录赠送'+(setting.wxConfig.money_login||0)+'枚金币'}}</view></view><view class="flex" style="width:30%;align-items:center;justify-content:center;"><button data-event-opts="{{[['tap',[['thumbsUp',['mine']]]]]}}" class="{{['cu-btn','','round','shadow','bg-'+themeClass]}}" style="margin-left:auto;" bindtap="__e">去完成</button></view></view></block><block wx:if="{{ad_id!='关闭'}}"><view class="margin-top"><ad unit-id="{{ad_id}}" ad-type="video" ad-theme="white"></ad></view></block></view></view>