'lg','bg-gradual-'+themeClass]}}" bindtap="__e">复制文案</button></view></view></block><block wx:if="{{TabCur==3}}"><view class="bg-white radius-xl  shadow bg-white"><view class="cu-bar bg-white radius-xl"><view class="action sub-title"><text class="{{['text-xl','text-bold','text-'+themeClass]}}">解析链接</text><text class="{{['text-ABC','text-'+themeClass]}}">content</text></view></view><view class="cu-form-group align-start"><textarea style="height:250rpx;background-color:#F9F9FB;border-radius:15rpx;padding:20rpx;" placeholder="点击下方按钮可以一键复制链接" data-event-opts="{{[['input',[['__set_model',['$0','y_url','$event',[]],['data']]]]]}}" value="{{data.y_url}}" bindinput="__e"></textarea></view><view class="padding flex flex-direction"><button data-event-opts="{{[['tap',[['copyText',['$0'],['data.y_url']]]]]}}" class="{{['cu-btn','lg','bg-gradual-'+themeClass]}}" bindtap="__e">复制链接</button></view></view></block><block wx:if="{{ad_id!='关闭'}}"><view class="padding-top" style="width:100%;"><ad unit-id="{{ad_id}}" ad-type="video" ad-theme="white"></ad></view></block></view></view>