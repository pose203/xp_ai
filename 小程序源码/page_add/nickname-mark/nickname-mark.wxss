page{background-color:#000}.popup-box{border-radius:20rpx 20rpx 0 0;background-color:#fff}.main-box{width:100vw;overflow:hidden;z-index:60;padding-bottom:440rpx;min-height:calc(100vh - 400rpx - 40rpx)}.main-box .main-image{width:100%}.controller-box{position:fixed;bottom:0;width:100%;background-color:#fff;border-radius:20rpx 20rpx 0 0;overflow:hidden;z-index:90}.controller-box .tab-box-inner{height:40rpx;line-height:40rpx}.controller-box .tab-inner-selected{color:#303133;background-color:#fff;border-radius:20rpx 20rpx 0 0}.controller-box .change-img-icon{width:49rpx;height:42rpx}.controller-box .down-img-icon{width:42rpx;height:42rpx}.controller-box .nickname-btn{margin:0;color:#2979ff;text-decoration:underline}.controller-box .swiper-box{width:100%;height:310rpx}.controller-box .swiper-box .color-box .color-circle{border:1rpx solid #e4e7ed;height:42rpx;width:42rpx;border-radius:50%;overflow:hidden}.controller-box .swiper-box .color-box .color-text{font-weight:700;color:#fff;text-shadow:#000 1rpx 0 0,#000 0 1rpx 0,#000 -1rpx 0 0,#000 0 -1rpx 0}.controller-box .swiper-box .color-box .color-image{width:100%;height:100%;border-radius:50%}.controller-box .ipt{height:48rpx;line-height:48rpx;border:1rpx solid #e4e7ed;border-right:0;border-radius:4rpx 0 0 4rpx}.controller-box .text-button{height:74rpx;line-height:68rpx;border-radius:0 4rpx 4rpx 0;border:1rpx solid #e4e7ed;padding:0 20rpx;background-color:#19be6b;color:#fff}.controller-box .ipt-focus{border-color:#19be6b}