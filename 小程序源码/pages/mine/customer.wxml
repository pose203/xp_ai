<view><cu-custom vue-id="4cc4c5b5-1" bgColor="{{'bg-gradual-'+themeClass}}" isBack="{{true}}" bind:__l="__l" vue-slots="{{['content']}}"><view slot="content">我的客户</view></cu-custom><scroll-view class="bg-white nav" scroll-x="{{true}}"><view class="flex text-center"><block wx:for="{{fixedList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="{{['cu-item','flex-sub',index==TabCur?'cur text-'+themeClass:'']}}" data-id="{{index}}" data-event-opts="{{[['tap',[['tabSelect',['$event']]]]]}}" bindtap="__e">{{''+item.name+''}}</view></block></view></scroll-view><block wx:if="{{TabCur==0}}"><view class="cu-list menu-avatar"><block wx:for="{{MyUser}}" wx:for-item="item" wx:for-index="index"><view class="cu-item "><view class="cu-avatar round lg" style="{{('background-image:url('+item.avatarUrl+');')}}"></view><view class="content"><view class="text-black"><view class="text-cut">{{item.nickName}}</view></view><view class="text-gray text-sm flex"><view class="text-cut">{{item.create_time}}</view></view></view></view></block></view></block><block wx:if="{{TabCur==1}}"><view class="cu-list menu-avatar"><block wx:for="{{Capital}}" wx:for-item="item" wx:for-index="index"><view class="cu-item "><view class="cu-avatar round lg" style="{{('background-image:url('+item.user.avatarUrl+');')}}"></view><view class="content"><view class="text-black"><view class="text-cut">{{item.user.nickName}}</view></view><view class="text-gray text-sm flex"><view class="text-cut">{{item.create_time}}</view></view></view><view class="action"><view class="cu-tag round bg-red sm">{{"+ "+item.money+"积分"}}</view></view></view></block></view></block><block wx:if="{{TabCur==2}}"><view class="cu-list menu-avatar"><block wx:for="{{Withdraw}}" wx:for-item="item" wx:for-index="index"><view class="cu-item "><view class="content" style="left:30rpx;"><block wx:if="{{item.apply_status==10}}"><view class="text-gray"><view class="text-cut">等待审核</view></view></block><block wx:if="{{item.apply_status==20}}"><view class="text-orange"><view class="text-cut">等待兑换</view></view></block><block wx:if="{{item.apply_status==30}}"><view class="text-red"><view class="text-cut">{{"已被驳回（"+item.reject_reason+"）"}}</view></view></block><block wx:if="{{item.apply_status==40}}"><view class="text-green"><view class="text-cut">已兑换</view></view></block><view class="text-gray text-sm flex"><view class="text-cut">{{item.create_time}}</view></view></view><view class="action"><view class="cu-tag round bg-red sm">{{item.apply_money+" 积分"}}</view></view></view></block></view></block></view>